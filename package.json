{
  "name": "radix-proofpath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json}\"",
    "contracts": "python -m scripts.generate_contracts && openapi-typescript shared/contracts/openapi.json -o shared/contracts/generated.ts",
    "dev:module": "vite --config vite.module.config.ts",
    "build:module": "vite build --config vite.module.config.ts",
    "test:handoff": "playwright test --config playwright.handoff.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
