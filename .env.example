RADIX_DATA_DIR=data/private
RADIX_ENV=development
RADIX_STORAGE_MODE=local
RADIX_AUTH_MODE=local
RADIX_DOCUMENT_STORAGE_MODE=local
RADIX_DOCUMENT_BUCKET=proofpath-documents
RADIX_ALLOWED_ORIGIN=http://127.0.0.1:5173
# Optional comma-separated exact origins; takes precedence over single origin:
RADIX_ALLOWED_ORIGINS=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Optional separate benchmark project. Server-side only.
RADIX_BENCHMARK_URL=
RADIX_BENCHMARK_KEY=
RADIX_BENCHMARK_ACCESS_TOKEN=
RADIX_BENCHMARK_EXPORT=
# JSON mapping: company, category, level, company_id optional; wide_levels optional.
RADIX_BENCHMARK_MAPPING=
RADIX_BENCHMARK_FILTER=
RADIX_LLM_MODE=auto
RADIX_LLM_URL=https://api.groq.com/openai/v1/chat/completions
RADIX_LLM_API_KEY=
RADIX_LLM_MODEL=openai/gpt-oss-20b
RADIX_LLM_FALLBACK=rules
RADIX_LLM_TIMEOUT_SECONDS=45
RADIX_LLM_MAX_OUTPUT_TOKENS=8192
